@model List<Song>

@{
    ViewData["Title"] = "Library";
    string? message = TempData["Message"] as string;
    string? error = TempData["Error"] as string;
}

@if (message != null || error != null)
{
    <div class="alert @(error != null ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        <strong>@(error ?? message)</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h2 fw-bold mb-0">Music Library</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" asp-action="Studio">Open 3D Studio</a>
        <a class="btn btn-success" asp-action="Edit" asp-route-id="0">+ Add new song</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded">
        <p class="mb-3">Your library is empty.</p>
        <a class="btn btn-success" asp-action="Edit" asp-route-id="0">Add your first song</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Song</th>
                    <th>Artist</th>
                    <th>Year</th>
                    <th>Album</th>
                    <th>Audio</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Song song in Model)
                {
                    <tr>
                        <td class="fw-semibold">@song.Title</td>
                        <td>@song.Artist</td>
                        <td>@song.Year</td>
                        <td>@song.Album</td>
                        <td>@(song.AudioFileName != null ? "🎧" : "—")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@song.SongId">Edit</a>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-song-id="@song.SongId" data-song-title="@song.Title">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div id="deleteModal" class="modal fade" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" id="deleteForm" asp-action="Delete">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalTitle">Delete song?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteSongTitle"></strong>? Its audio file will be removed too. This can't be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Fill the confirmation dialog with the song that was clicked.
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteSongTitle').textContent = button.dataset.songTitle;
            document.getElementById('deleteForm').action = '@Url.Action("Delete", "Music")/' + encodeURIComponent(button.dataset.songId);
        });
    </script>
}
