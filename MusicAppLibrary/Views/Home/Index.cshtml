@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">Music Library</h1>
    <p class="lead text-muted mb-5">Keep track of your songs, play them on a 3D turntable, and sing along in karaoke mode.</p>

    <div class="row justify-content-center g-4">
        <div class="col-md-5">
            <a class="option-card" asp-controller="Music" asp-action="Studio">
                <span class="option-icon">💿</span>
                <span class="option-title">3D Studio</span>
                <span class="option-text">Browse your records in 3D, play them with a live visualizer, and switch on karaoke mode.</span>
            </a>
        </div>
        <div class="col-md-5">
            <a class="option-card" asp-controller="Music" asp-action="Index">
                <span class="option-icon">📋</span>
                <span class="option-title">Library table</span>
                <span class="option-text">Add, edit and delete songs in a simple list.</span>
            </a>
        </div>
    </div>
</div>
